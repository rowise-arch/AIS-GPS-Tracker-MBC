{
  "version": 2,
  "builds": [
    {
      "src": "web-app/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "web-app/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/web-app/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/web-app/$1"
    }
  ]
}